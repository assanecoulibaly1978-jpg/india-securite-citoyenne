# Exemple uniquement — NE PAS copier de vraie clé dans ce fichier.
# Le .env réel reste privé et n'est pas modifié par cette préparation.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Deux verrous indépendants : garder false pendant la préparation.
AI_ENABLED=false
AI_ALLOW_PAID=false
# Aucun accès au pilote tant que ce jeton local n'est pas configuré.
# Il devra être aléatoire, distinct de la clé OpenAI, au moins 32 caractères.
AI_PILOT_TOKEN=

# Provisions de coût en USD, abaissables uniquement pour ce pilote.
# Plafonds du code : 1 USD/jour, 2 USD/mois. 0 bloque toute génération.
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=2
