            margin-bottom: -0px !important;
            color: gray !important;
            font-weight: 600;
        }

        .captcha_code_ban .captcha_form {
            position: relative;
            display: flex;
            margin: 0;
            padding: 10px 0px;
        }

        .captcha_code_ban .captcha_form input {
            margin-left: 5px !important;
            height: 30px !important;
            margin-top: 2px !important;
            max-width: 125px;
        }

        .captcha_code_ban .captcha_form input:focus {
            border: 1px solid var(--vert);
            /* Vert doux */
            outline: none;
            box-shadow: none;
        }

        .captcha_code_ban .message {
            position: relative;
            width: 100%;
            font-size: 11px;
        }
    </style>
