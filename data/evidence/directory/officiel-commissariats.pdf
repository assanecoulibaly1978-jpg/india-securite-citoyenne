    <script>
        function validate() {
            var search_value = document.forms["search-form"]["search"].value;
            if (search_value == "") {
                document.forms["search-form"]["search"].focus();
                return false;
            }
        }

        $(document).ready(function() {
            $('#menu_toggle').click(function() {
                console.log('Alert');
                $('.sidebar').toggleClass('active');
                $('').toggleClass('active');
                $('.screen').toggleClass('active');
            });

            $('.screenBtn').click(function() {
                $('.sidebar').toggleClass('active');
                $('').toggleClass('active');
                $('.screen').toggleClass('active');
            });
        });


        $('.sidebar .item.first-level > a').click(function(event) {
            $(this).parent().toggleClass('submenu-show').siblings().removeClass('submenu-show');
        });

        $('#navBar.container-fluid .navigation .menu ul .drop-menu li').click(function(event) {
            $(this).toggleClass('active').siblings().removeClass('active');
        });


        $(document).ready(function() {
            $('.toggle .icon').click(function() {
                $('.searchForm').toggleClass('active');
            });
        });
    </script>

