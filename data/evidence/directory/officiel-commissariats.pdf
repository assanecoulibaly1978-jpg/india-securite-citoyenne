    <style>
        body {
            margin: 0;
            padding: 0;
            /* font-family: Arial, Helvetica, sans-serif; */
            font-family: 'Inter', sans-serif !important;
            background: linear-gradient(to top, #40a437, rgba(221, 255, 221, 0.9));
        }

        div,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        section,
        article,
        p,
        b,
        em,
        span,
        u {
            font-family: 'Inter', sans-serif !important;
        }

        #main_page {
            position: relative;
            width: 1300px;
            margin: auto;
            margin-top: 250px;
            padding: 25px;
            background-color: #fff;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
            z-index: 1;
        }

        #dark-mode-button {
            position: fixed;
            top: 25px;
            right: 10px;
            z-index: 1000000000;
        }

        #dark-mode-button .checkbox {
            opacity: 0;
            position: absolute;
        }

        #dark-mode-button .checkbox-label {
            background-color: var(--vert);
            width: 45px;
            height: 25px;
            border-radius: 50px;
            position: relative;
            padding: 5px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #dark-mode-button .fa-moon {
            color: #f1c40f;
        }

        #dark-mode-button .fa-sun {
            color: #f39c12;
        }

        #dark-mode-button .checkbox-label .ball {
            background-color: #fff;
            width: 20px;
            height: 20px;
            position: absolute;
            left: 2px;
            top: 2px;
            border-radius: 50%;
            transition: transform 0.2s linear;
        }

        #dark-mode-button .checkbox:checked+.checkbox-label .ball {
            transform: translateX(22px);
        }


        body.dark-mode,
        body.dark-mode #main_page {
            background-color: #131313 !important;
        }

        body.dark-mode h1 body.dark-mode h2,
        body.dark-mode h3,
        body.dark-mode h4,
        body.dark-mode div,
        body.dark-mode p,
        {
        color: yellow !important;
        }

        .dark-mode #dark-mode-button .checkbox-label {
            background-color: #111;
        }
    </style>
</head>

