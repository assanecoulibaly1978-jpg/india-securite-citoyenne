<style>
    .social-popup,
    .social-popup *,
    .social-fab,
    .social-fab * {
        box-sizing: border-box;
    }

    .social-popup[hidden],
    .social-fab[hidden] {
        display: none !important;
    }

    .social-popup,
    .social-fab {
        --social-color: #168653;
        --social-dark: #116e43;
        --social-ink: #172b4d;
        --social-muted: #5f6d7e;

        position: fixed;
        z-index: 99990;
        right: 15px;
        bottom: 15px;
        opacity: 0;
        transform: translateY(14px);
        transition: opacity .25s ease, transform .25s ease;
        font-family: Arial, Helvetica, sans-serif;
    }

    .social-popup--visible,
    .social-fab--visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Popup */
    .social-popup {
        width: min(275px, calc(100vw - 24px));
        padding: 20px;
        background: #e2e2e2;
        color: var(--social-ink);
        border: 1px solid #e6eaf0;
        border-radius: 14px;
        line-height: 1.45;
        box-shadow:
            0 18px 48px rgba(19, 39, 62, .18),
            0 2px 8px rgba(19, 39, 62, .08);
    }

    .social-popup__close {
        position: absolute;
        top: 7px;
        right: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #526071;
        cursor: pointer;
        transition: background .2s, color .2s;
    }

    .social-popup__close:hover {
        background: #edf0f4;
        color: #172b4d;
    }

    .social-popup__head {
        display: flex;
        flex-direction: column;
    }

    .social-popup__head .head_box {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-right: 16px;
    }


    .social-popup__logo {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        object-fit: contain;
    }

    .social-popup__identity {
        min-width: 0;
    }

    .social-popup__title {
        margin: 0;
        font-size: 13.5px;
        font-weight: 700;
        line-height: 1.4;
    }

    .social-popup__verified {
        display: inline-block;
        width: 15px;
        height: 15px;
        margin-left: 2px;
        vertical-align: -3px;
        color: #4778ea;
    }

    .social-popup__network {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 5px 0 0;
        color: var(--social-color);
        font-size: 12px;
        font-weight: 700;
    }

    .social-popup__network i {
        font-size: 14px;
    }

    .social-popup__text {
        margin: 17px 0 13px;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
    }

    .social-popup__trust {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-bottom: 15px;
        padding: 11px;
        border: 1px solid #e5eee9;
        border-radius: 10px;
        background: #f5f9f6;
        color: #416452;
        font-size: 11.5px;
        font-weight: 600;
        line-height: 1.5;
    }

    .social-popup__trust i {
        flex: 0 0 auto;
        margin-top: 2px;
        color: var(--social-color);
        font-size: 15px;
    }

    .social-popup__cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 45px;
        padding: 12px;
        border-radius: 9px;
        background: var(--social-color);
        color: #fff !important;
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        text-decoration: none !important;
        transition: background .2s, transform .2s;
    }

    .social-popup__cta:hover {
        background: var(--social-dark);
        color: #fff !important;
        transform: translateY(-1px);
    }

    .social-popup__cta>i:first-child {
        font-size: 17px;
    }

    .social-popup__external {
        margin-left: auto;
        font-size: 11px;
        opacity: .8;
    }

    /* Bulle flottante */
    .social-fab {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: #fff;
        cursor: pointer;
        box-shadow:
            0 8px 24px rgba(19, 39, 62, .22),
            0 2px 6px rgba(19, 39, 62, .1);
    }

    .social-fab--visible:hover {
        transform: translateY(-2px) scale(1.04);
    }

    .social-fab__logo {
        width: 38px;
        height: 38px;
        object-fit: contain;
    }

    .social-fab__badge {
        position: absolute;
        right: -3px;
        bottom: -3px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        border: 2px solid #fff;
        border-radius: 50%;
        background: var(--social-color);
        color: #fff;
    }

    .social-fab__badge i {
        font-size: 13px;
    }

    .social-fab--visible::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 2px solid var(--social-color);
        border-radius: 50%;
        opacity: 0;
        animation: social-ring 1.4s ease-out 2;
        pointer-events: none;
    }

    @keyframes social-ring {
        0% {
            transform: scale(1);
            opacity: .6;
        }

        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .social-popup__close:focus-visible,
    .social-popup__cta:focus-visible,
    .social-fab:focus-visible {
        outline: 2px solid var(--social-color);
        outline-offset: 3px;
    }

    @media (max-width: 480px) {

        .social-popup,
        .social-fab {
            right: 12px;
            bottom: calc(12px + env(safe-area-inset-bottom, 0px));
        }

        .social-popup {
            width: min(300px, calc(100vw - 24px));
            padding: 16px;
        }

        .social-popup__logo {
            width: 44px;
            height: 44px;
            flex-basis: 44px;
        }

        .social-popup__text {
            margin: 12px 0;
            font-size: 14px;
        }

        .social-fab {
            width: 56px;
            height: 56px;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        .social-popup,
        .social-popup *,
        .social-fab,
        .social-fab * {
            transition: none !important;
            animation: none !important;
        }

        .social-fab--visible::after {
            display: none;
        }
    }
</style>

<script>
    (() => {
        'use strict';

        const DELAY_MS = 8000;
        const SCROLL_RATIO = 0.25;

        // Afficher le popup uniquement sur la page d'accueil.
        const path = window.location.pathname.replace(/\/+$/, '') || '/';

        if (!['/accueil-v28285888', '/accueil-push-reseaux'].includes(path)) {
            return;
        }

        const networks = [{"id":"whatsapp","name":"WhatsApp","title":"Cha\u00eene WhatsApp officielle","description":"L\u2019actualit\u00e9 gouvernementale, en temps r\u00e9el.","url":"https:\/\/whatsapp.com\/channel\/0029VaAaupP3gvWbdLehv92N","color":"#168653","dark":"#116e43","icon":"fa-brands fa-whatsapp","button":"Rejoindre la cha\u00eene"},{"id":"facebook","name":"Facebook","title":"Le Gouvernement sur Facebook","description":"Suivez les actualit\u00e9s et les actions du Gouvernement.","url":"https:\/\/www.facebook.com\/gouvciofficiel","color":"#1877F2","dark":"#125bc0","icon":"fa-brands fa-facebook-f","button":"Suivre la page"},{"id":"youtube","name":"YouTube","title":"Cha\u00eene YouTube officielle","description":"Retrouvez les vid\u00e9os et les temps forts de l\u2019actualit\u00e9 gouvernementale.","url":"https:\/\/www.youtube.com\/user\/gouvcivideo","color":"#FF0000","dark":"#cc0000","icon":"fa-brands fa-youtube","button":"Voir les vid\u00e9os"},{"id":"twitter","name":"X (Twitter)","title":"Le Gouvernement sur X","description":"Suivez les derni\u00e8res informations et annonces officielles.","url":"https:\/\/x.com\/Gouvciofficiel","color":"#242424","dark":"#000000","icon":"fa-brands fa-x-twitter","button":"Suivre le compte"},{"id":"instagram","name":"Instagram","title":"Le Gouvernement sur Instagram","description":"D\u00e9couvrez les actualit\u00e9s gouvernementales en images.","url":"https:\/\/www.instagram.com\/gouvci.officiel","color":"#C13584","dark":"#96266a","icon":"fa-brands fa-instagram","button":"D\u00e9couvrir le compte"},{"id":"tiktok","name":"TikTok","title":"Le Gouvernement sur TikTok","description":"D\u00e9couvrez les vid\u00e9os courtes et les temps forts de l\u2019actualit\u00e9.","url":"https:\/\/www.tiktok.com\/@gouvciofficiel","color":"#111111","dark":"#000000","icon":"fa-brands fa-tiktok","button":"Voir les vid\u00e9os"},{"id":"telegram","name":"Telegram","title":"Le Gouvernement sur Telegram","description":"Retrouvez les informations officielles sur notre canal Telegram.","url":"https:\/\/t.me\/GouvCIOfficiel","color":"#0088CC","dark":"#006699","icon":"fa-brands fa-telegram","button":"Rejoindre le canal"},{"id":"linkedin","name":"LinkedIn","title":"Le Gouvernement sur LinkedIn","description":"Suivez les actualit\u00e9s institutionnelles et les initiatives du Gouvernement.","url":"https:\/\/ci.linkedin.com\/company\/gouvernement-de-cote-d-ivoire","color":"#0A66C2","dark":"#084b91","icon":"fa-brands fa-linkedin-in","button":"Suivre la page"}];

        const popup = document.getElementById('social-popup');
        const fab = document.getElementById('social-popup-fab');
        const closeBtn = document.getElementById('social-popup-close');

        if (!popup || !fab || !closeBtn || popup.dataset.ready) {
            return;
        }

        popup.dataset.ready = 'true';

        const popupNetworkIcon =
            document.getElementById('social-popup-network-icon');
        const popupNetworkName =
            document.getElementById('social-popup-network-name');
        const popupDescription =
            document.getElementById('social-popup-description');
        const popupCta = document.getElementById('social-popup-cta');
        const popupCtaIcon =
            document.getElementById('social-popup-cta-icon');
        const popupCtaText =
            document.getElementById('social-popup-cta-text');
        const fabIcon = document.getElementById('social-fab-icon');

        // Tirage aléatoire du réseau pour cette visite de la page.
        const network = networks[
            Math.floor(Math.random() * networks.length)
        ];



        // Personnalisation du popup et de la bulle flottante.
        const applyNetwork = () => {
            [popup, fab].forEach(element => {
                element.style.setProperty('--social-color', network.color);
                element.style.setProperty('--social-dark', network.dark);
            });

            popupNetworkIcon.className = network.icon;
            popupNetworkName.textContent = network.title;
            popupDescription.textContent = network.description;

            popupCta.href = network.url;
            popupCtaIcon.className = network.icon;
            popupCtaText.textContent = network.button;

            fabIcon.className = network.icon;
            fab.setAttribute(
                'aria-label',
                'Découvrir le compte officiel du Gouvernement sur ' +
                network.name
            );
        };

        applyNetwork();

        const timers = new WeakMap();

        const toggle = (element, visible) => {
            const className = element === popup ?
                'social-popup--visible' :
                'social-fab--visible';

            window.clearTimeout(timers.get(element));

            if (visible) {
                element.hidden = false;

                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        element.classList.add(className);
                    });
                });
            } else {
                element.classList.remove(className);

                const timer = window.setTimeout(() => {
                    element.hidden = true;
                }, 250);

                timers.set(element, timer);
            }
        };

        const onKey = event => {
            if (event.key === 'Escape' && !popup.hidden) {
                minimize();
            }
        };

        const openPopup = () => {
            toggle(fab, false);
            toggle(popup, true);
            document.addEventListener('keydown', onKey);
        };

        const minimize = () => {
            toggle(popup, false);
            toggle(fab, true);
            document.removeEventListener('keydown', onKey);

            window.setTimeout(() => {
                if (!fab.hidden) {
                    fab.focus({
                        preventScroll: true
                    });
                }
            }, 260);
        };

        let started = false;

        const onScroll = () => {
            const max = document.documentElement.scrollHeight -
                window.innerHeight;

            if (max > 0 && window.scrollY / max >= SCROLL_RATIO) {
                start();
            }
        };

        const start = () => {
            if (started) return;

            started = true;
            window.clearTimeout(timer);
            window.removeEventListener('scroll', onScroll);

            openPopup();
        };

        const timer = window.setTimeout(start, DELAY_MS);

        window.addEventListener('scroll', onScroll, {
            passive: true
        });

        closeBtn.addEventListener('click', minimize);
        fab.addEventListener('click', openPopup);
    })();
</script>
        <head>
    <script>
        $(document).ready(function(){
    
                $('.facebook-popup').click(function(event) { 
                    
                    $(this).toggleClass('active').siblings().removeClass('active');
                    var url_video = $('.facebook-popup.active iframe').attr('src'); //récupération de l'url de la vidéo sur laquelle on a cliqué
                    
                    $('#facebook_popup .video iframe').attr('src', url_video); //Passage de l'url à l'iframe de la fenêtre popup
        
                    $('#facebook_popup').toggleClass('active'); //Affichade la fenêtre popup
                });
    
                $('#facebook_popup').click(function(event) {
                    $('#facebook_popup .video iframe').attr('src', '');
                    $('#facebook_popup').removeClass('active');
                });
            }); 
    </script>

</head>


